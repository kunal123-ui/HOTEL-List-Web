# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection (Discrete values)
PGHOST=localhost
PGPORT=5432
PGDATABASE=hotel_db
PGUSER=postgres
PGPASSWORD=postgres

# Alternatively, specify a single PostgreSQL connection string:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hotel_db

# CORS Origin (Frontend URL)
CLIENT_URL=http://localhost:5173
